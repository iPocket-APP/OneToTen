# Optional. Bind the local dev or preview server to a LAN address (or 0.0.0.0 for all interfaces).
# FILE_ROOM_HOST=192.168.1.100

# Optional. Allow the local dev or preview server on a trusted LAN to transfer over HTTP.
# Ignored when HTTPS or FILE_ROOM_SITE_URL is set. Receivers with IndexedDB can stage and resume.
# FILE_ROOM_LAN_HTTP=1

# Optional. Let the browser on the Mac running the dev server save received files
# to Downloads and select them in Finder.
# FILE_ROOM_LOCAL_FINDER=1

# Optional. Enable HTTPS with a certificate trusted by every device.
# FILE_ROOM_TLS_CERT=/absolute/path/to/cert.pem
# FILE_ROOM_TLS_KEY=/absolute/path/to/key.pem

# Optional. Configure a STUN endpoint for reflexive ICE candidates.
# VITE_ROOM_STUN_URL=stun:stun.example.com:3478

# Optional. Override the public HTTPS origin for a build or supply it for a local proxy.
# FILE_ROOM_SITE_URL=https://files.example.com

